<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Microclimate.App.ViewModels"
        x:Class="Microclimate.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Моніторинг мікроклімату"
        Width="760" Height="520">

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Кімнати" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Opacity="0.6" Margin="0,12,0,0"/>

    <ListBox ItemsSource="{Binding Rooms}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RoomViewModel">
          <Grid ColumnDefinitions="2*,*,*,*,2*" Margin="4,8">
            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{Binding Temperature}"/>
            <TextBlock Grid.Column="2" Text="{Binding Humidity}"/>
            <TextBlock Grid.Column="3" Text="{Binding Co2}"/>
            <TextBlock Grid.Column="4" Text="{Binding Comfort}"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
